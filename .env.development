# Container Postgres
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=quizzes_dev

# Aplicacao Postgres
DATABASE_URL=postgresql://postgres_user:postgres_password@localhost:5432/quizzes_dev
APP_URL=http://localhost:3000
BCRYPT_ROUNDS=12
PASSWORD_PEPPER=pepper-de-desenvolvimento

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
